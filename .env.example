# =============================================================================
# Ollama Server - Platform Configuration Profiles
# =============================================================================
# Vælg din platform og kopier den tilsvarende .env.* fil til .env:
#
#   NUC5 + ASUS GX10:    cp .env.nuc5 .env   && ./start.sh
#   Windows 11 + RTX:    cp .env.win11 .env  && docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
#   Raspberry Pi 5:      cp .env.pi5 .env    && docker compose up -d
#   Default (alle):      cp .env.example .env (og redigér selv)
#
# =============================================================================

OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=24h
